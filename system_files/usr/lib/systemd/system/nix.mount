[Unit]
Description=Nix store (/var/nix bound to /nix)
Documentation=https://github.com/outergod/bazzite-hyprland
Requires=nix-var-dir.service
After=nix-var-dir.service
RequiresMountsFor=/var
# The nix RPMs' tmpfiles rules must populate /nix/var inside the persistent store
Before=systemd-tmpfiles-setup.service nix-daemon.socket nix-daemon.service

[Mount]
What=/var/nix
Where=/nix
Type=none
Options=bind

[Install]
WantedBy=local-fs.target
