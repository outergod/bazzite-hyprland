[Desktop Entry]
Type=Application
Name=Secret Storage Service (Hyprland)
Comment=Completes the gnome-keyring daemon unlocked at login
# pam_gnome_keyring starts the daemon with --login, and it exits after 120 s
# unless `--start` initializes it. gnome-keyring-secrets.desktop does that only
# for GNOME, Unity and MATE; uwsm runs this entry for Hyprland sessions.
Exec=/usr/bin/gnome-keyring-daemon --start --components=secrets
OnlyShowIn=Hyprland;
NoDisplay=true
